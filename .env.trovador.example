# =====================================================================
# Trovador — environment additions (T8 Rekognition + realtime + queue)
# Append the relevant blocks to your real .env. NEVER commit the real .env.
# =====================================================================

# --- Queue: async moderation needs a real queue + a running worker ---
# (sync = runs inline; fine for a quick test but not the real async flow)
QUEUE_CONNECTION=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# --- AWS Rekognition (visual moderation) ---
AWS_ACCESS_KEY_ID=__from_client_credentials_pdf__
AWS_SECRET_ACCESS_KEY=__from_client_credentials_pdf__
AWS_DEFAULT_REGION=us-east-1
REKOGNITION_ENABLED=true
# Optional overrides (admin panel usually controls these instead):
# REKOGNITION_REJECT_THRESHOLD=85
# REKOGNITION_REVIEW_THRESHOLD=70
# REKOGNITION_VIDEO_FRAMES=5
# REKOGNITION_JOB_TIMEOUT=300

# --- OAuth logins (T9: env-first, wired in SettingsServiceProvider) ---
GOOGLE_CLIENT_ID=__from_client_credentials_pdf__
GOOGLE_CLIENT_SECRET=__from_client_credentials_pdf__
FACEBOOK_CLIENT_ID=__from_client_credentials_pdf__
FACEBOOK_CLIENT_SECRET=__from_client_credentials_pdf__
# Spotify (wire the same env-first pattern where spotify creds are injected):
SPOTIFY_CLIENT_ID=__from_client_credentials_pdf__
SPOTIFY_CLIENT_SECRET=__from_client_credentials_pdf__

# --- MercadoPago (only payment gateway) — T9 ------------------------
# Use TEST credentials until go-live, then switch to production.
MERCADOPAGO_ACCESS_TOKEN=__TEST_token_until_golive__
MERCADOPAGO_PUBLIC_KEY=__TEST_public_key_until_golive__
MERCADOPAGO_CLIENT_ID=__from_client_credentials_pdf__
MERCADOPAGO_CLIENT_SECRET=__from_client_credentials_pdf__

# --- Resend (transactional email) — T9 ------------------------------
RESEND_API_KEY=__from_client_credentials_pdf__

# --- Cloudflare R2 media storage (needed for deploy) ----------------
R2_ACCESS_KEY_ID=__pending_from_client__
R2_SECRET_ACCESS_KEY=__pending_from_client__
R2_BUCKET=__pending_from_client__
R2_ENDPOINT=__pending_from_client__

# --- Broadcasting / realtime -----------------------------------------
# Primary: Laravel Reverb (self-hosted, free). pusher-php-server talks to it
# via the pusher connection options below, so app + frontend stay unchanged.
BROADCAST_DRIVER=reverb

REVERB_APP_ID=trovador
REVERB_APP_KEY=trovador_key
REVERB_APP_SECRET=change_me_long_random
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

# The app's Pusher-protocol client reads these; point them at Reverb:
PUSHER_APP_ID="${REVERB_APP_ID}"
PUSHER_APP_KEY="${REVERB_APP_KEY}"
PUSHER_APP_SECRET="${REVERB_APP_SECRET}"
PUSHER_HOST="${REVERB_HOST}"
PUSHER_PORT="${REVERB_PORT}"
PUSHER_SCHEME="${REVERB_SCHEME}"
PUSHER_APP_CLUSTER=mt1

# --- Future migration to Pusher cloud (leave commented until needed) ---
# To switch Reverb -> Pusher, set BROADCAST_DRIVER=pusher and fill these,
# no code/frontend changes required (client's requirement):
# PUSHER_APP_ID=__pusher_cloud_id__
# PUSHER_APP_KEY=__pusher_cloud_key__
# PUSHER_APP_SECRET=__pusher_cloud_secret__
# PUSHER_APP_CLUSTER=us2
